# 模型 API 配置。本文件已在 .gitignore 中，不会被提交到 GitHub。
# 推荐在网页右上角的 ⚙ 设置里填写（选服务商、填 API Key、选模型），会自动保存到这里；也可以直接编辑本文件。

# 服务商：deepseek（DeepSeek 官方）、custom（其他 OpenAI 兼容服务，填它的接口地址）
# 项目只按标准 OpenAI 兼容接口调用
CODER_PROVIDER=deepseek

# API 密钥（必填）
CODER_API_KEY=

# 接口地址：选了 deepseek 时可以不填，自动使用它的地址；custom 必须填写
CODER_BASE_URL=https://api.deepseek.com

# 模型名，以服务商文档为准
CODER_MODEL=deepseek-flash

# 单次任务最多调用模型的轮数
# CODER_MAX_STEPS=50

# 上下文超过这么多 token 时自动压缩（0 表示不压缩）
# CODER_CONTEXT_LIMIT=200000

# 沙箱模式：agent 的命令在 Docker 容器里执行（只挂载工作区、默认断网、非 root）。
# 需要 Docker Desktop，并先构建一次镜像：python -m coder.sandbox build
# CODER_SANDBOX=1
